# Copy to `.env` (git-ignored). docker-compose.yml overrides MONGO_URI and REDIS_URL for the
# container network.
ENVIRONMENT=dev

# Must be a replica set (docker compose provides a single-node one): writes use transactions.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mokhotsi

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Shared rate-limit store. Leave empty in dev to keep limits in process memory; required in prod.
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and stalls.
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

IDEMPOTENCY_TTL_HOURS=24
# Only true behind a reverse proxy you control (it sets X-Forwarded-For).
TRUST_PROXY_HEADERS=false

# JSON list; empty = CORS disabled (the mobile app does not need CORS).
CORS_ORIGINS=[]
LOG_LEVEL=INFO
