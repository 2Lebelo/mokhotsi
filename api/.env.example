# Copy to `.env` (git-ignored). docker-compose.yml overrides MONGO_URI for the container network.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mokhotsi
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# JSON list; empty = CORS disabled (the mobile app does not need CORS).
CORS_ORIGINS=[]
LOG_LEVEL=INFO
