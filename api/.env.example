# Copy to `.env` (git-ignored). docker-compose.yml overrides MONGO_URI and REDIS_URL for the
# container network.
ENVIRONMENT=dev

# Must be a replica set (docker compose provides a single-node one): writes use transactions.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mokhotsi

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_HOURS=12
DEVICE_TOKEN_TTL_MINUTES=15

# Shared rate-limit store. Leave empty in dev to keep limits in process memory; required in prod.
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and stalls.
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_PIN_CHANGE_PER_HOUR=10

# Wrong PINs lock the account; each further lockout doubles, up to PIN_LOCKOUT_MAX_HOURS.
PIN_MAX_FAILURES=5
ADMIN_PIN_MAX_FAILURES=3
PIN_LOCKOUT_SECONDS=60
PIN_LOCKOUT_MAX_HOURS=24

MAX_SHOPS_PER_OWNER=20

IDEMPOTENCY_TTL_HOURS=24

# Country calling code for phone numbers entered without one (266 = Lesotho).
DEFAULT_COUNTRY_CODE=266

# First system admin, created by: uv run python -m app.cli seed-admin
# The admin signs in with this phone number and 5-digit PIN. Seeding is idempotent: an existing
# admin is left unchanged (use --reset-pin to change the PIN). Avoid easy PINs (11111, 12345,
# 12121); they are refused. Clear SEED_ADMIN_PIN once the admin has been created.
SEED_ADMIN_PHONE=
SEED_ADMIN_PIN=
SEED_ADMIN_NAME=System Admin
# The client IP (rate limits, audit) comes from uvicorn, which reads X-Forwarded-For only from
# the proxies listed here (comma-separated IPs/CIDRs, never "*" on a public host). Set it to your
# host's proxy address; the default trusts only 127.0.0.1.
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Product photos and correction crops (https://console.cloudinary.com → API Keys). Required in
# prod. Phones upload directly with a short-lived signature from the API; assets are stored as
# "authenticated" (private). In the Cloudinary console, restrict uploads to jpg/png/webp up to
# 5 MB and enable "Strict transformations" (Settings → Security).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JSON list; empty = CORS disabled (the mobile app does not need CORS).
CORS_ORIGINS=[]
LOG_LEVEL=INFO
