{
  "schema_version": 1,
  "detector": {
    "file": "detector.tflite",
    "arch": "yolov8n",
    "input": [640, 640, 3],
    "dtype": "float32",
    "input_range": [0, 1],
    "score_threshold": 0.25,
    "model_version": "yolov8n-640@placeholder"
