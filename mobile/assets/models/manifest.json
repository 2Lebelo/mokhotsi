  "embedder": {
    "file": "embedder.tflite",
    "arch": "mobilenet_v2",
    "input": [224, 224, 3],
    "dtype": "float32",
    "input_range": [-1, 1],
    "dim": 1280,
    "model_version": "mobilenet_v2-224-1280@placeholder"
  },
  "match_threshold": 0.75
}
