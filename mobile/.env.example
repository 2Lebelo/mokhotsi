# Copy to .env.local (git-ignored) and restart Metro.
#
# The Mokhotsi API (../api). Leave it unset for an offline-only build.
# On a phone, use your computer's LAN address, not localhost. Release builds
# must use HTTPS: Android refuses plain HTTP outside development builds.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
#
# Research builds only: shows Menu → Evaluation (owners) for measuring recognition
# accuracy and latency (docs/evaluation-protocol.md). Leave unset for shop builds.
# EXPO_PUBLIC_EVALUATION=1
