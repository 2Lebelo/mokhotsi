{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["../contracts/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/types/*.d.ts"],
  "exclude": ["node_modules", "android", "ios", "__tests__", "jest.setup.ts"]
}
