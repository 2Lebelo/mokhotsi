{
  // Tests and Jest setup run in Node, so they also get Node's types. App code (tsconfig.json)
  // does not, so Node-only globals such as Buffer cannot leak into the bundle.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"]
  },
  "include": ["__tests__/**/*.ts", "jest.setup.ts", "src/types/*.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
