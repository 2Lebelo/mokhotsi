{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.13.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "http://192.168.1.20:8000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://staging.api.example.invalid"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://api.example.invalid"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
